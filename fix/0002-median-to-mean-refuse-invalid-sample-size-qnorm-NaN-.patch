From b2db847cfac47dbb1486cc18defcc3f5b0fa1182 Mon Sep 17 00:00:00 2001
From: "Claude Opus 5 (lane)" <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 07:51:50 +0100
Subject: [PATCH 2/2] median-to-mean: refuse invalid sample size; qnorm NaN
 outside [0,1]; Shi 2020 journal

Root cause: runCalc only warned for n < 5 and then evaluated the Wan,
Luo and Shi formulas for any n, so n = 0, negative, non-integer, 1 or
blank produced displayed/exported numbers (e.g. SD 0.000 for n = 0,
because qnorm returned -Infinity for p < 0).

- runCalc: n must be a whole number >= 2; otherwise an input-check note,
  no table rows, no plot marks, export {refused: true, estimates: []}.
- qnorm: NaN for p outside [0, 1] (R semantics); unchanged inside.
- footer: Shi et al. 2020 is in Res Synth Methods (not Stat Methods Med
  Res) and refines the five-number SD only; C3 uses Wan's SD.

Valid inputs (whole n >= 2) give bit-identical results to 1cb3f84.
median-to-mean/tests/invalid-n.test.cjs: 21/21 (was 2/21).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 median-to-mean/index.html | 16 +++++++++++++---
 1 file changed, 13 insertions(+), 3 deletions(-)

diff --git a/median-to-mean/index.html b/median-to-mean/index.html
index ab18ea6..cca6fc0 100644
--- a/median-to-mean/index.html
+++ b/median-to-mean/index.html
@@ -103,7 +103,7 @@
     </section>
   </main>
   <footer>
-    Formulas: Wan et al., BMC Med Res Methodol 2014 (for mean &amp; SD from C1/C2/C3). Luo et al., Stat Methods Med Res 2018 (refined mean for C1/C2/C3). Shi et al., Stat Methods Med Res 2020 (refined SD for C1/C3). Use Luo-for-mean and Shi-for-SD as the modern default unless your MA software specifies otherwise. <strong>R-parity:</strong> all three estimators match the published equations evaluated with R&#8217;s exact <code>qnorm</code> (Wichura AS241) to 1e-6 across C1/C2/C3 (<code>hub/shared/tests/median-to-mean-parity.spec.mjs</code>).
+    Formulas: Wan et al., BMC Med Res Methodol 2014 (for mean &amp; SD from C1/C2/C3). Luo et al., Stat Methods Med Res 2018 (refined mean for C1/C2/C3). Shi et al., Res Synth Methods 2020 (refined SD for C1; C3 uses Wan's SD). Use Luo-for-mean and Shi-for-SD as the modern default unless your MA software specifies otherwise. <strong>R-parity:</strong> all three estimators match the published equations evaluated with R&#8217;s exact <code>qnorm</code> (Wichura AS241) to 1e-6 across C1/C2/C3 (<code>hub/shared/tests/median-to-mean-parity.spec.mjs</code>).
   </footer>
   <script>
     // --- Inverse normal CDF (Φ⁻¹) via Abramowitz-Stegun 26.2.23 ---
@@ -112,7 +112,8 @@
     // which propagated into the Wan/Shi SD estimators (they divide by
     // 2·qnorm((n-0.375)/(n+0.25))).
     function qnorm(p) {
-      if (p <= 0) return -Infinity;
+      if (!(p >= 0 && p <= 1)) return NaN;  // as R: qnorm(p) is NaN outside [0, 1]
+      if (p === 0) return -Infinity;
       if (p >= 1) return Infinity;
       const q = p - 0.5;
       let r, val;
@@ -208,7 +209,15 @@
       // Validation
       const warnSlot = document.getElementById("warn-slot");
       warnSlot.innerHTML = "";
-      if (!Number.isFinite(n) || n < 5) {
+      // The estimators are defined for a sample size, a whole number >= 2; anything else is refused, not estimated.
+      if (!Number.isFinite(n) || n < 2 || !Number.isInteger(n)) {
+        warnSlot.innerHTML = `<div class="note"><strong>Input check:</strong> n must be a whole number of at least 2 (the sample size). No estimate is shown.</div>`;
+        render([]);
+        _lastM2M = { _schema: "median-to-mean-results-v1", scenario: scenario, n: Number.isFinite(n) ? n : null,
+          refused: true, estimates: [] };
+        return;
+      }
+      if (n < 5) {
         warnSlot.innerHTML = `<div class="note"><strong>Warning:</strong> sample size is very small (n &lt; 5). These estimators are known to be unreliable below ~15; Wan et al. recommend at least n=25.</div>`;
       }
       let orderBad = false;
@@ -255,6 +264,7 @@
       const W = 600, H = Math.max(150, 40 + rows.length * 36);
       svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
       svg.innerHTML = "";
+      if (!rows.length) return;
 
       const leftPad = 220, rightPad = 30;
       const plotW = W - leftPad - rightPad;
